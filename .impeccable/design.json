      "name": "Primary action",
      "kind": "button",
      "description": "The next setup or play action.",
      "html": "<button class=\"ds-primary\"><svg viewBox=\"0 0 24 24\" width=\"17\" height=\"17\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"5\" y=\"10\" width=\"14\" height=\"11\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"/></svg> Play against computer <svg viewBox=\"0 0 24 24\" width=\"17\" height=\"17\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font-family:Manrope,system-ui,sans-serif;display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:49px;padding:13px 15px;border:0;border-radius:9px;background:var(--green,#265b4d);color:#fffef8;font-size:12px;font-weight:800;cursor:pointer;transition:background .15s}.ds-primary:hover{background:#174535}.ds-primary:focus-visible{outline:3px solid var(--focus,#c28a22);outline-offset:4px;}.ds-primary:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}",
      "refersTo": "button-primary"
    },
