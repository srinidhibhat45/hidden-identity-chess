      "css": ".ds-table{font-family:Manrope,system-ui,sans-serif;max-width:570px;padding:19px 24px 21px;border-radius:17px;background:var(--deep,#183e38);color:#f3f3e9;box-shadow:0 14px 32px #00000014}.ds-player{display:flex;justify-content:space-between;align-items:center;gap:11px;min-height:43px;margin-bottom:15px;font-size:12px;font-weight:700}.ds-player span{padding:5px 9px;border:1px solid #55736a;border-radius:6px;font-size:10px;font-weight:400;color:#dbe8dc}.ds-bottom{margin:16px 0 0}.ds-board{display:grid;grid-template-columns:repeat(8,1fr);aspect-ratio:1;border-radius:4px;overflow:hidden}.ds-square{position:relative;display:grid;place-items:center;aspect-ratio:1;min-width:0;padding:0;border:0;border-radius:0;background:var(--ivory,#e8ead3);cursor:pointer}.ds-dark{background:var(--sage,#91af94)}.ds-square svg{width:78%;height:78%;filter:drop-shadow(0 3px 1px #00000026)}.ds-square:hover::after{content:\"\";position:absolute;inset:0;background:#ffffff18;pointer-events:none}.ds-square:focus-visible{outline:3px solid var(--board-focus,#87640d);outline-offset:-4px;z-index:2}",
      "refersTo": "board-table"
    }
  ],
  "narrative": {
    "northStar": "Modern Board-Game Lounge",
    "overview": "A familiar, relaxed place to play chess with friends. The muted teal table, ivory and sage squares, and geometric chess silhouettes make the game recognizable immediately. Friendly Manrope lettering and softly rounded controls keep the experience neither cartoonish nor formal.\n\nThe board carries the visual weight. The surrounding interface stays quiet, precise, and compact, with a clear next action and deliberate emphasis when a concealed piece is revealed.",
    "keyCharacteristics": [
      "A tactile teal table on warm paper.",
      "Recognizable geometric pieces and shield-shaped concealed identities.",
      "Quiet controls with warm yellow selection and turn cues.",
      "A board-first layout on desktop and mobile."
    ],
    "rules": [
      {
        "name": "The State Color Rule",
        "body": "Keep yellow tied to selection, turn, reveal, or a high-priority action on a dark surface.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** keep the board dominant and place it before settings on mobile.",
      "**Do** retain recognizable geometric chess silhouettes and shield-shaped concealed identities.",
      "**Do** preserve keyboard focus through state updates and provide a visible outline.",
      "**Do** keep handoff coverage opaque and honor reduced-motion preferences."
    ],
    "donts": [
      "**Don't** introduce cartoon mascots or formal tournament ornament.",
      "**Don't** use yellow as general surface decoration.",
      "**Don't** reveal an opponent's identity through a visual or accessibility label.",
      "**Don't** replace the restrained tone-and-border hierarchy with heavy shadows on every control."
    ]
  }
}
