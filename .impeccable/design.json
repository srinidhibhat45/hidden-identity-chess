      "html": "<label class=\"ds-field\">Room code<input class=\"ds-input\" aria-label=\"Room code\" maxlength=\"7\" placeholder=\"7-letter code\" autocomplete=\"off\" autocapitalize=\"characters\" spellcheck=\"false\"></label>",
      "css": ".ds-field{font-family:Manrope,system-ui,sans-serif;display:block;color:var(--ink,#193b35);font-size:11px;font-weight:800}.ds-input{font-family:Manrope,system-ui,sans-serif;display:block;width:calc(100% - 26px);margin-top:9px;padding:12px;border:1px solid #c6d3c0;border-radius:8px;background:var(--white,#fffefa);color:var(--ink,#193b35);font-size:14px;font-weight:400;text-transform:uppercase;letter-spacing:2px;caret-color:var(--green,#265b4d)}.ds-input:hover{border-color:var(--green,#265b4d)}.ds-input:focus-visible{outline:3px solid var(--focus,#c28a22);outline-offset:4px;}",
      "refersTo": "room-input"
    },
    {
      "name": "Play modes",
      "kind": "nav",
      "description": "Three equal choices on one tonal track.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Choose how to play\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Computer</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Online friend</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Same device</button></div>",
      "css": ".ds-tabs{display:flex;gap:3px;padding:4px;border-radius:11px;background:#e6ebe1}.ds-tab{font-family:Manrope,system-ui,sans-serif;flex:1;min-width:0;padding:11px 5px;border:0;border-radius:8px;background:transparent;color:#55685c;font-size:11px;font-weight:700;cursor:pointer}.ds-tab[aria-selected=true]{background:var(--white,#fffefa);color:var(--ink,#193b35);box-shadow:0 2px 5px #00000010}.ds-tab:hover{background:#fffefa99}.ds-tab:focus-visible{outline:3px solid var(--focus,#c28a22);outline-offset:4px;}",
      "refersTo": "mode-tab-selected"
    },
    {
      "name": "Active turn pill",
      "kind": "chip",
      "description": "An active status on the dark playing table.",
      "html": "<span class=\"ds-pill\">To move</span>",
      "css": ".ds-pill{font-family:Manrope,system-ui,sans-serif;display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border:1px solid var(--yellow,#f3cf70);border-radius:6px;background:var(--yellow,#f3cf70);color:var(--deep,#183e38);font-size:10px;font-weight:800}",
      "refersTo": "side-pill-active"
    },
    {
      "name": "Difficulty selector",
      "kind": "nav",
      "description": "A compact selected fill within a bordered group.",
      "html": "<div class=\"ds-segmented\" role=\"group\" aria-label=\"Computer difficulty\"><button aria-pressed=\"true\">Casual</button><button aria-pressed=\"false\">Club</button><button aria-pressed=\"false\">Challenger</button></div>",
      "css": ".ds-segmented{display:flex;gap:3px;padding:3px;border:1px solid #d5dece;border-radius:9px}.ds-segmented button{font-family:Manrope,system-ui,sans-serif;flex:1;padding:9px 6px;border:0;border-radius:6px;background:transparent;color:var(--muted,#586e66);font-size:11px;font-weight:700;cursor:pointer}.ds-segmented button[aria-pressed=true]{background:#dde8d5;color:var(--deep,#183e38)}.ds-segmented button:hover{background:#e9eedf}.ds-segmented button:focus-visible{outline:3px solid var(--focus,#c28a22);outline-offset:4px;}"
    },
    {
      "name": "Revealed kings switch",
      "kind": "custom",
      "description": "A labeled rule choice with a restrained sliding switch.",
      "html": "<button class=\"ds-toggle\" role=\"switch\" aria-checked=\"true\"><span><strong>Revealed kings</strong><small>Show both kings. Keep the rest a mystery.</small></span><span class=\"ds-switch\" aria-hidden=\"true\"></span></button>",
      "css": ".ds-toggle{font-family:Manrope,system-ui,sans-serif;display:flex;align-items:center;justify-content:space-between;gap:15px;width:100%;padding:17px 0;border:0;border-top:1px solid var(--line,#dce2d8);border-bottom:1px solid var(--line,#dce2d8);background:none;text-align:left;color:var(--ink,#193b35);cursor:pointer}.ds-toggle strong{display:block;font-size:11px}.ds-toggle small{display:block;margin-top:5px;font-size:10px;color:var(--muted,#586e66)}.ds-switch{position:relative;flex-shrink:0;width:34px;height:20px;border-radius:14px;background:#b9c8b8;transition:background .15s}.ds-switch::after{content:\"\";position:absolute;width:14px;height:14px;left:3px;top:3px;background:white;border-radius:50%;transition:transform .15s}.ds-toggle[aria-checked=true] .ds-switch{background:var(--green,#265b4d)}.ds-toggle[aria-checked=true] .ds-switch::after{transform:translateX(14px)}.ds-toggle:focus-visible{outline:3px solid var(--focus,#c28a22);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-switch,.ds-switch::after{transition:none}}"
    },
    {
      "name": "Playing table",
      "kind": "card",
