      "css": ".ds-text{font-family:Manrope,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 12px;border:0;border-radius:8px;background:transparent;color:var(--ink,#193b35);font-size:12px;font-weight:700;cursor:pointer}.ds-text:hover{background:var(--line,#dce2d8)}.ds-text:focus-visible{outline:3px solid var(--focus,#c28a22);outline-offset:3px}"
    },
