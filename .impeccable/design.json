      "css": ".ds-secondary{font-family:Manrope,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:41px;padding:10px 13px;border:1px solid #d3ddcf;border-radius:9px;background:var(--white,#fffefa);color:var(--ink,#193b35);font-size:11px;font-weight:700;cursor:pointer}.ds-secondary:hover{background:#e9eedf}.ds-secondary:focus-visible{outline:3px solid var(--focus,#c28a22);outline-offset:4px;}.ds-secondary:disabled{opacity:.5;cursor:default}",
      "refersTo": "button-secondary"
